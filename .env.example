
# development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Global route prefix — all endpoints mount under this path
API_PREFIX=api/v1

# Display name shown in logs and Swagger
APP_NAME=EchoGPT API

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# Matches the values in docker-compose.yml. Change if you use an external DB.
DB_HOST=localhost
DB_PORT=5432
DB_USER=echogpt
DB_PASSWORD=echogpt
DB_NAME=echogpt

# Enable SSL. Required for managed Postgres (RDS, Neon, Supabase).
# Dev with local Postgres: leave false. Prod: usually true.
DB_SSL=false

# Log every SQL query TypeORM executes.
# Development only — NEVER enable in production (leaks PII into logs).
DB_LOGGING=true

# Schema synchronization. ALWAYS false — schema changes only via migrations.
# This variable is intentionally ignored by the app; documented for clarity.
DB_SYNCHRONIZE=false

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
# Generate fresh secrets before running anywhere real:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Minimum 32 characters. Use DIFFERENT values for access and refresh.
JWT_ACCESS_SECRET=<generate-a-random-48-byte-string>
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=<generate-a-different-random-48-byte-string>
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# Encryption (AES-256-GCM)
# ─────────────────────────────────────────────────────────────────────────────
# Used to encrypt AI provider API keys at rest.
# MUST be exactly 64 hex characters (32 bytes).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️  Changing this key AFTER storing provider keys will make them undecryptable.
ENCRYPTION_KEY=<generate-64-hex-chars>

# ─────────────────────────────────────────────────────────────────────────────
# Redis (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Used for cache-manager and distributed throttler storage.
# Leave empty to fall back to in-memory cache (fine for single-instance dev).
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
# Global default. Per-route overrides live in @Throttle() decorators.
THROTTLE_TTL=60        # window in seconds
THROTTLE_LIMIT=60      # max requests per window per IP

# ─────────────────────────────────────────────────────────────────────────────
# Web Search Provider
# ─────────────────────────────────────────────────────────────────────────────
# Default uses DuckDuckGo's public Instant Answers API (no key required).
# Swap in a real search provider (SerpAPI, Brave Search, Tavily) as needed.
SEARCH_API_URL=https://api.duckduckgo.com
SEARCH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Swagger / OpenAPI
# ─────────────────────────────────────────────────────────────────────────────
# Dev: true — full interactive docs at http://localhost:3000/api/docs
# Prod: false — reduce attack surface; opt in only if the docs are public-facing.
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ─────────────────────────────────────────────────────────────────────────────
# Seeds (npm run db:seed)
# ─────────────────────────────────────────────────────────────────────────────
# Demo accounts created by the seed script. CHANGE BEFORE ANY REAL DEPLOY.
SEED_ADMIN_EMAIL=admin@echogpt.local
SEED_ADMIN_PASSWORD=Admin@123

SEED_USER_EMAIL=user@echogpt.local
SEED_USER_PASSWORD=User@123

# Placeholder API keys for the three system AI providers.
# These are encrypted and stored but never used against real vendor APIs
# unless you replace them with working keys.
OPENAI_SEED_KEY=sk-placeholder-openai
CLAUDE_SEED_KEY=sk-placeholder-claude
GEMINI_SEED_KEY=sk-placeholder-gemini